{
    "id" : "io.github.trunar.Hovir",
    "runtime" : "org.gnome.Platform",
    "runtime-version" : "50",
    "sdk" : "org.gnome.Sdk",
    "command" : "hovir",
    "finish-args" : [
        "--share=network",
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri",
        "--socket=pulseaudio"
    ],
    "cleanup" : [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "*.la",
        "*.a"
    ],
    "modules" : [
        {
            "name" : "python-dependencies",
            "buildsystem" : "simple",
            "build-options" : {
                "build-args" : [ "--share=network" ]
            },
            "build-commands" : [
                "python3 -m pip install --disable-pip-version-check --no-warn-script-location --no-compile --prefix=/app -r requirements-flatpak.txt"
            ],
            "sources" : [
                { "type" : "dir", "path" : "." }
            ]
        },
        {
            "name" : "hovir",
            "builddir" : true,
            "buildsystem" : "meson",
            "sources" : [
                {
                    "type" : "dir",
                    "path" : "."
                }
            ]
        }
    ]
}
